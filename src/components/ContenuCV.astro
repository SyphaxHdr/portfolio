---
import { adresse, cv, FACES, textes, type FaceProjet, type Langue } from '../lib/contenu';

interface Props {
  langue: Langue;
  face: FaceProjet;
}

const { langue, face } = Astro.props;
const t = await textes(langue);
const fichier = cv(face, langue);
const nomFace = { production: t.production, devops: t.devops };
const facesCV = FACES.filter((f) => cv(f, langue));
---

{
  fichier && (
    <div class="cv">
      <div class="cv__barre">
        {facesCV.length > 1 && (
          <nav class="cv__bascule" aria-label={t.cvChoisir}>
            {facesCV.map((f) => (
              <a href={adresse(langue, `/${f}/cv/`)} aria-current={f === face ? 'page' : undefined}>
                {nomFace[f]}
              </a>
            ))}
          </nav>
        )}
        <p class="cv__actions">
          <a class="bouton" href={fichier.pdf} target="_blank" rel="noopener">
            {t.cvOuvrir}
          </a>
          <a class="bouton bouton--plein" href={fichier.pdf} download>
            {t.cvTelecharger}
          </a>
        </p>
      </div>

      <div class="cv__page">
        <img
          src={fichier.petit ?? fichier.image}
          srcset={fichier.petit ? `${fichier.petit} 900w, ${fichier.image} ${fichier.largeur}w` : undefined}
          sizes="(min-width: 66rem) 62rem, calc(100vw - 2rem)"
          width={fichier.largeur}
          height={fichier.hauteur}
          alt={`${t.cvTitre} · ${nomFace[face]}`}
          fetchpriority="high"
        />
        {fichier.liens.map((l) => (
          <a
            class="cv__lien"
            href={l.href}
            aria-label={l.texte}
            style={`left: ${l.x}%; top: ${l.y}%; width: ${l.l}%; height: ${l.h}%`}
          />
        ))}
      </div>
    </div>
  )
}
