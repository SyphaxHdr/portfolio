---
import '../styles/fenetres.css';
import Fenetre from './Fenetre.astro';
import Contact from './Contact.astro';
import Pipeline from './Pipeline.astro';
import { profil, textes, type Langue } from '../lib/contenu';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const t = await textes(langue);
const p = await profil();
---

{
  p.formulaire && (
    <Fenetre nom="contact" titre={t.meContacter} fermer={t.fermerFenetre}>
      <Contact langue={langue} prefixe="fenetre" />
    </Fenetre>
  )
}
<Fenetre nom="maintenance" titre={t.commentMaintenu} fermer={t.fermerFenetre} large>
  <Pipeline langue={langue} />
</Fenetre>

<script>
  import '../scripts/fenetres.js';
</script>
