---
import '../styles/fil.css';
import {
  adresseProjet,
  ancreSolution,
  elementsDe,
  etatProjet,
  parcours,
  projets,
  slug,
  solutions,
  textes,
  type Element,
  type FaceProjet,
  type Langue,
  type Projet,
  type Solution,
} from '../lib/contenu';

interface Props {
  face: FaceProjet;
  langue: Langue;
}

const { face, langue } = Astro.props;
const t = await textes(langue);
const listeProjets = await projets(langue, face);
const listeSolutions = await solutions(langue, face);
const etapes = await parcours(langue);
const devops = face === 'devops';
const MAX_ELEMENTS = 5;

function meta(projet: Projet) {
  if (devops) return projet.data.pile.join(' · ');
  const equipe = projet.data.equipe === 1 ? t.seul : `${t.equipeDe} ${projet.data.equipe}`;
  return [projet.data.role, equipe, projet.data.periode].join(' · ');
}

const libelle = (s: Solution) => (devops ? s.data.commit : s.data.titre);
const lien = (s: Solution, projet: Projet) => `${adresseProjet(face, projet)}#${ancreSolution(s)}`;
const nombre = (e: Element) => (e.type === 'solution' ? 1 : e.solutions.length);
---

<div class:list={['fil', `fil--${face}`]}>
  {
    listeProjets.map((projet) => {
      const elements = elementsDe(projet, listeSolutions);
      const visibles = elements.slice(0, MAX_ELEMENTS);
      const reste = elements.slice(MAX_ELEMENTS).reduce((n, e) => n + nombre(e), 0);
      const enCours = projet.data.statut === 'en-cours';

      return (
        <section
          class:list={['bloc', { 'bloc--en-cours': enCours }]}
          id={`${face}-${slug(projet.id)}`}
          style={`--sc: var(--branche-${projet.data.couleur})`}
        >
          <i class="bloc__tronc" aria-hidden="true" />
          <i class="bloc__branche" aria-hidden="true" />
          {enCours ? (
            <svg class="bloc__tete" viewBox="0 0 28 28" aria-hidden="true">
              <circle class="tete__piste" cx="14" cy="14" r="12" />
              <circle class="tete__arc" cx="14" cy="14" r="12" pathLength="100" />
              <circle class="tete__point" cx="14" cy="14" r="6" />
            </svg>
          ) : (
            <i class="bloc__losange" aria-hidden="true" />
          )}

          <div class="bloc__entete">
            <h2 class="bloc__titre">
              <a href={adresseProjet(face, projet)}>{devops ? projet.data.titreDevops : projet.data.titre}</a>
            </h2>
            <span class:list={['etat', { 'etat--plein': enCours }]}>{etatProjet(projet, t)}</span>
          </div>
          {meta(projet) && <p class="bloc__meta">{meta(projet)}</p>}

          {visibles.length > 0 && (
            <ul class="commits">
              {visibles.map((el) =>
                el.type === 'solution' ? (
                  <li class="commit">
                    <a class="commit__texte" href={lien(el.solution, projet)}>
                      {libelle(el.solution)}
                    </a>
                    {devops && el.solution.data.noteDevops && (
                      <span class="commit__note">{el.solution.data.noteDevops}</span>
                    )}
                  </li>
                ) : (
                  <li class="sous-projet">
                    <i class="sp__branche" aria-hidden="true" />
                    <i class="sp__losange" aria-hidden="true" />
                    <span class="sp__titre">
                      {!devops && <span class="sp__type">{t.sousProjet}</span>}
                      {devops ? el.sousProjet.titreDevops : el.sousProjet.titre}
                    </span>
                    <ul>
                      {el.solutions.map((s) => (
                        <li>
                          <a class="commit__texte" href={lien(s, projet)}>
                            {libelle(s)}
                          </a>
                        </li>
                      ))}
                    </ul>
                  </li>
                ),
              )}
              {reste > 0 && (
                <li class="commit commit--plus">
                  <a href={`${adresseProjet(face, projet)}#problemes`}>
                    + {reste} {devops ? t.autresCommits : t.autresSolutions}
                  </a>
                </li>
              )}
            </ul>
          )}
        </section>
      );
    })
  }

  {
    etapes.length > 0 && (
      <section class="bloc bloc--parcours" id={`parcours-${face}`}>
        <i class="bloc__tronc" aria-hidden="true" />
        <h2 class="bloc__titre">{devops ? t.parcoursDevops : t.parcours}</h2>
        <ol class="parcours">
          {etapes.map((e, i) => (
            <li class:list={['etape', { 'etape--fin': i === etapes.length - 1 }]}>
              <span class="etape__annees">{e.annees}</span>
              <span class="etape__texte">{e.texte}</span>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  <i class="fil__queue" aria-hidden="true"></i>
</div>
