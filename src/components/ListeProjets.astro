---
import { projets, solutions, textes, type FaceProjet, type Langue } from '../lib/contenu';

interface Props {
  face: FaceProjet;
  langue: Langue;
}

const { face, langue } = Astro.props;
const t = await textes(langue);
const listeProjets = await projets(langue, face);
const listeSolutions = await solutions(langue, face);
const devops = face === 'devops';

const solutionsDe = (idProjet: string) =>
  listeSolutions.filter((s) => s.data.projet.id === idProjet);
---

<div class="projets">
  {
    listeProjets.map((projet) => (
      <article class="projet" style={`--couleur-branche: var(--branche-${projet.data.couleur})`}>
        <h2 class="projet__titre">{devops ? projet.data.titreDevops : projet.data.titre}</h2>
        <p class="projet__resume">{devops ? projet.data.resumeDevops : projet.data.resume}</p>
        {solutionsDe(projet.id).length > 0 && (
          <>
            <h3 class="projet__sous-titre">{t.solutions}</h3>
            <ul class="solutions">
              {solutionsDe(projet.id).map((s) =>
                devops ? (
                  <li class="solution">
                    <span class="etiquette">{s.data.branche}</span>
                    <code>{s.data.commit}</code>
                  </li>
                ) : (
                  <li class="solution">{s.data.titre}</li>
                ),
              )}
            </ul>
          </>
        )}
      </article>
    ))
  }
</div>
