---
import { profil, textes, type Langue } from '../lib/contenu';
import { dateDernierCommit } from '../lib/date';
import { infosBuild } from '../lib/build';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const t = await textes(langue);
const p = await profil();
const b = infosBuild();

const date = dateDernierCommit();
const dateLisible = new Intl.DateTimeFormat(langue === 'fr' ? 'fr-FR' : 'en-GB', {
  dateStyle: 'long',
}).format(date);
---

<footer class="pied">
  <div class="conteneur pied__contenu">
    <nav aria-label={t.liens}>
      <ul class="pied__liens">
        {
          p.formulaire && (
            <li>
              <a href="/contact/" data-fenetre="contact">
                {t.meContacter}
              </a>
            </li>
          )
        }
        {
          p.liens.map((lien) => (
            <li>
              <a href={lien.url} rel="me">
                {lien.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
    <div class="pied__meta">
      <p class="pied__maintenu">
        <a href="/maintenance/" data-fenetre="maintenance">
          {t.commentMaintenu}
        </a>
      </p>
      <p class="pied__date">
        {t.miseAJour} <time datetime={date.toISOString()}>{dateLisible}</time>
      </p>
      <p class="pied__build">
        {b.lienVersion ? <a href={b.lienVersion}>{b.version}</a> : <span>{b.version}</span>}
        {
          b.court && (
            <>
              <span aria-hidden="true">·</span>
              {b.lienCommit ? <a href={b.lienCommit}>{b.court}</a> : <span>{b.court}</span>}
            </>
          )
        }
        <span aria-hidden="true">·</span>
        {b.lienPublication ? <a href={b.lienPublication}>{t.publiePar}</a> : <span>{t.construitEnLocal}</span>}
      </p>
    </div>
  </div>
</footer>
