---
import { cv, FACES, profil, textes, type FaceProjet, type Langue } from '../lib/contenu';

interface Props {
  langue: Langue;
  cvFace?: FaceProjet;
}

const { langue, cvFace } = Astro.props;
const t = await textes(langue);
const p = await profil();
// Le bouton CV mène à la page du CV de la face affichée (accueil : production).
const facesCV = FACES.filter((face) => cv(face, langue));
const liensCV = facesCV.length
  ? [
      { pour: 'neutre', href: `/${facesCV[0]}/cv/` },
      ...facesCV.map((face) => ({ pour: face, href: `/${face}/cv/` })),
    ]
  : [];
---

<header class="entete">
  <div class="conteneur entete__contenu">
    <a class="entete__nom" href="/">
      <span>{p.nom}</span>
      <span class="entete__type">{t.portfolio}</span>
    </a>
    <div class="entete__actions">
      {
        FACES.map((f) => (
          <a class="entete__lien" href={`/${f}/#parcours-${f}`} data-pour={f}>
            {t.parcours}
          </a>
        ))
      }
      {
        liensCV.map((l) => (
          <a
            class="entete__bouton"
            href={l.href}
            data-pour={l.pour}
            aria-current={cvFace && l.href === `/${cvFace}/cv/` ? 'page' : undefined}
          >
            {t.cv}
          </a>
        ))
      }
      {
        p.formulaire && (
          <a class="entete__bouton entete__bouton--plein" href="/contact/" data-fenetre="contact">
            <span class="si-large">{t.meContacter}</span>
            <span class="si-etroit">{t.contact}</span>
          </a>
        )
      }
    </div>
  </div>
</header>
