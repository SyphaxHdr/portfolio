---
import { profil, textes, type Langue } from '../lib/contenu';

interface Props {
  langue: Langue;
}

const { langue } = Astro.props;
const t = await textes(langue);
const p = await profil();
const faces = ['production', 'devops'];
---

<header class="entete">
  <div class="conteneur entete__contenu">
    <a class="entete__nom" href="/">{p.nom}</a>
    <div class="entete__actions">
      {
        faces.map((f) => (
          <a class="entete__lien" href={`#parcours-${f}`} data-pour={f}>
            {t.parcours}
          </a>
        ))
      }
    </div>
  </div>
</header>
