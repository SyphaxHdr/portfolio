---
import Base from '../layouts/Base.astro';
import Faces from '../components/Faces.astro';
import { profil, textes, titrePage } from '../lib/contenu';

const t = await textes('fr');
const p = await profil();
---

<Base titre={titrePage('neutre', t, p)} face="neutre">
  <Faces face="neutre" langue="fr" />
</Base>
