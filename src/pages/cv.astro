---
import { adresse, type Langue } from '../lib/contenu';

// Ancienne adresse : elle renvoie vers le CV production.
const langue: Langue = 'fr';
const cible = adresse(langue, '/production/cv/');
---

<html lang={langue}>
  <head>
    <meta charset="utf-8" />
    <meta name="robots" content="noindex" />
    <meta http-equiv="refresh" content={`0; url=${cible}`} />
    <link rel="canonical" href={cible} />
    <title>CV · Syphax Hadri</title>
  </head>
  <body>
    <p><a href={cible}>CV</a></p>
  </body>
</html>
