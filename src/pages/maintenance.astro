---
import Base from '../layouts/Base.astro';
import Pipeline from '../components/Pipeline.astro';
import { profil, textes } from '../lib/contenu';

const t = await textes('fr');
const p = await profil();
---

<Base titre={`${t.commentMaintenu} · ${p.nom}`} face="neutre">
  <section class="page-simple">
    <h1>{t.commentMaintenu}</h1>
    <Pipeline langue="fr" />
  </section>
</Base>
