---
import Base from '../layouts/Base.astro';
import Fil from '../components/Fil.astro';
import { profil, textes } from '../lib/contenu';

const t = await textes('fr');
const p = await profil();
---

<Base titre={`${t.production} · ${p.nom}`} face="production">
  <h1>{t.production}</h1>
  <Fil face="production" langue="fr" />
</Base>
