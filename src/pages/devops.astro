---
import Base from '../layouts/Base.astro';
import Fil from '../components/Fil.astro';
import { profil, textes } from '../lib/contenu';

const t = await textes('fr');
const p = await profil();
---

<Base titre={`${t.devops} · ${p.nom}`} face="devops">
  <h1>{t.devops}</h1>
  <Fil face="devops" langue="fr" />
</Base>
